# MQTT配置
MQTT_BROKER_URL=tcp://183.6.33.81:1883
MQTT_USERNAME=zfiUser
MQTT_PASSWORD=zfiUser@123
MQTT_CLIENT_ID=NEST20202412U002

# 飞丢告警子进程调用主进程 MQTT 代理的密钥（仅本机 127.0.0.1）
LOST_ALERT_JOB_SECRET=local-lost-alert-job

# 订阅主题（多个主题用逗号分隔）
# 使用通配符 + 订阅所有设备
MQTT_TOPICS=thing/product/+/osd,thing/product/+/state,thing/product/+/events

# 服务器配置
PORT=3001
WS_PORT=3002
# 默认区域（首次启动自动创建，设备/飞行数据存于 haizhuDB/regions/<id>/）
# DEFAULT_REGION_ID=haizhu
# DEFAULT_REGION_NAME=海珠

# GPT Image 2（xomodel）— 密钥勿提交仓库
XOMODEL_API_URL=https://api.xomodel.com
XOMODEL_API_KEY=sk-your-key-here
# 与渠道可用模型一致：官方示例 gpt-image-2；NewAPI 渠道常用 nova-g-image-2
XOMODEL_IMAGE_MODEL=gpt-image-2
# 图生图默认用 curl 转发（与官方示例一致）；设为 0 则仅用 Node fetch
# IMAGE_EDIT_USE_CURL=1
# 图生图上游 size 默认 auto（与 xomodel 成功记录一致）；设为 0 才按分辨率/宽高比算像素
# IMAGE_EDIT_FORCE_AUTO_SIZE=1
# 图生图 quality，控制台成功多为 standard
# IMAGE_EDIT_QUALITY=standard
# 图生图参考图长边上限（像素），过大易触发上游 502
# IMAGE_EDIT_MAX_EDGE=2048

# 飞行助手 & 告警 AI（火山方舟 Responses API）— 密钥勿提交仓库
# 控制台「快捷 API 接入」获取 ARK_API_KEY 与模型 ID
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your-ark-api-key-here
ARK_MODEL=doubao-seed-2-0-mini-260428

# 联网搜索：auto=探测到外网时自动开启 web_search，1=强制开启，0=关闭
ARK_WEB_SEARCH=auto
# 外网探测地址（默认火山方舟）
# NETWORK_PROBE_URL=https://ark.cn-beijing.volces.com
# NETWORK_PROBE_TIMEOUT_MS=4000
# 控制台 [AI用量] 仅为本项目本地 token 累计（默认按 100 万做进度条），不是扣费账单
# 限流/繁忙时由 ark-client 自动重试；与 [AI用量] 无关
# AI_USAGE_LOG=0 关闭每次请求的用量日志
# AI_TOKEN_DISPLAY_TOTAL=1000000 虚拟座舱进度条用的本地上限
# 设为 0 关闭告警触发时的多模态 AI 分析（需 ARK_API_KEY）
# ALERT_AI_ENABLED=1

# 助手注入飞行记录：近 N 天、最多 M 条（默认 7 天 / 18 条）
# ASSISTANT_FLIGHT_DAYS=7
# ASSISTANT_FLIGHT_LIMIT=18

# 企业微信 markdown.content 单条 UTF-8 字节上限（官方 4096）
# WECOM_MARKDOWN_MAX=4096
# AI 分析正文最大汉字数（推送前再按字节截断，默认 900）
# ALERT_AI_MARKDOWN_MAX=900

# 飞丢分析：GPS 距机场小于该半径（米）视为「在机场附近」，默认 150
# ALERT_DOCK_RADIUS_M=150

# 直播流截图基址（默认区域；其它区域在「区域管理 → 数据连接」单独配置）
# STREAM_BASE_URL=https://www.hzdkjw.com:1443/live
# 推流鉴权 token（默认区域；增城等需在区域 connectivity.json 配置 stream.token）
# STREAM_TOKEN=

# 非默认区域 MQTT/推流：在管理后台「区域管理 → 数据连接」保存，或复制
# haizhuDB/regions/connectivity.example.json → haizhuDB/regions/<区域ID>/connectivity.json

# Dock 系列机场（Dock / Dock2 / Dock3）：舱内/舱外共用 _out 推流，切换需 MQTT live_camera_change
# DOCK_LIVE_VIDEO_ID_TEMPLATE={deviceId}/165-0-7/normal-0
# LIVE_VIDEO_ID_8UUXP3B00A10VD=8UUXP3B00A10VD/165-0-7/normal-0
# DOCK_GATEWAY_SNS=7CTDM1200B453R  （名称不含 Dock 时仍启用 Dock 能力）
# DOCK3_GATEWAY_SNS=  （兼容旧配置，与 DOCK_GATEWAY_SNS 等效）
# 舱内/舱外无法从 live_status 推断，状态持久化于 server/data/dock-live-state.json
# 飞丢告警 Dock 截图：切换成功后等待秒数再 ffmpeg 截图（默认 3）
# DOCK_ALERT_SWITCH_DELAY_MS=3000
# DOCK_ALERT_SNAPSHOT_TIMEOUT_MS=25000


# ========== 阈值配置 ==========
# 格式: 最小值,最大值 (用逗号分隔)
# 多区间格式: 用分号分隔多个区间，如 0,20;30,70
# 状态判断: 值在normal区间内为正常, warning区间内为警告, critical区间内为严重

# 风速阈值 (m/s)
WIND_SPEED_NORMAL=0,6.6
WIND_SPEED_WARNING=6.6,12
WIND_SPEED_CRITICAL=12,999

# 湿度阈值 (%) - 多区间示例
# 正常: 0-20% 或 30-70%
# 警告: 20-30% 或 70-80%
# 严重: 80-100%
HUMIDITY_NORMAL=0,20;30,70
HUMIDITY_WARNING=20,30;70,80
HUMIDITY_CRITICAL=80,100

# ========== 设备配置 ==========
# 格式: 设备ID=设备名称 (每行一个)
# 用于在界面上显示友好的设备名称
# 单兵遥控器一般无需手写：系统会根据无人机 OSD 的 gateway（9N9 开头）或遥控器 sub_device 自动绑定并命名为「xx-M4T-遥控器」
# 仅在自动绑定失败时手动指定，例如：
# DEVICE_9N9CN9G0016TJP=新港派出所-M4T-遥控器

DEVICE_8UUXP3B00A10VD=南洲-Dock3-M4TD
DEVICE_7CTDM1200B453R=华洲-Dock2-M3TD
DEVICE_NEST20202412U002=江南中-充电-M3T
DEVICE_NEST44202512U014=区府-换电-M4T
DEVICE_AHRXNAH00A01C6=凤阳-Dock3-M4TD
DEVICE_AHRXNAH00A01DF=华洲-Dock3-M4TD
DEVICE_AHRXNAH00A0192=中大-Dock3-M4TD
DEVICE_AHRXNAH00A01CE=金碧二中-Dock3-M4TD
DEVICE_NEST15202602U001-1=会展-双机换电1号-M4T
DEVICE_NEST15202602U001-2=会展-双机换电2号-M4T
DEVICE_AHRXNAH00A019F=官洲-Dock3-M4TD
DEVICE_AHRXNAH00A01DM=新看守-Dock3-M4TD
DEVICE_AHRXNAH00A019D=三中-Dock3-M4TD
DEVICE_NEST44202602U002=艺术博物馆-换电-M4T
DEVICE_AHRXNAH00A018Z=分局-Dock3-M4TD
DEVICE_1581F9HEC259S00C6YKP=巡特警二中队—M4T（2号机）
